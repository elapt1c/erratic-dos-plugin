{
  "plugin_id": "ddos_tool",
  "name": "DDoS Tool", 
  "version": "1.0",
  "description": "Network stress testing tool with C2 safety",
  "author": "erratic",
  "entry_point": "plugin.py",
  "dependencies": [],
  "ui_schema": [
    {"type": "section", "label": "Target Configuration"},
    {"type": "text", "name": "target_ip", "label": "Target IP", "default": "127.0.0.1"},
    {"type": "number", "name": "target_port", "label": "Target Port", "default": 80, "min": 1, "max": 65535},
    
    {"type": "section", "label": "Attack Settings"},
    {"type": "select", "name": "attack_type", "label": "Attack Type", "default": "tcp_flood", "options": [
      {"label": "TCP Flood", "value": "tcp_flood"},
      {"label": "UDP Flood", "value": "udp_flood"},
      {"label": "ICMP Flood", "value": "icmp_flood"},
      {"label": "Slowloris", "value": "slowloris"},
      {"label": "HTTP GET Flood", "value": "http_get"},
      {"label": "All Methods", "value": "all"}
    ]},
    {"type": "number", "name": "threads", "label": "Threads", "default": 100, "min": 1, "max": 10000},
    {"type": "number", "name": "duration", "label": "Duration (seconds)", "default": 60, "min": 1, "max": 3600},
    
    {"type": "section", "label": "Safety"},
    {"type": "toggle", "name": "enable_c2_check", "label": "Enable C2 Connectivity Check", "default": true},
    
    {"type": "section", "label": "Control"},
    {"type": "button", "name": "start_attack", "label": "Start Attack"},
    {"type": "button", "name": "stop_attack", "label": "Stop Attack"},
    
    {"type": "section", "label": "Status"},
    {"type": "output", "name": "status", "label": "Attack Status", "height": "100px"},
    {"type": "output", "name": "stats", "label": "Statistics", "height": "150px"},
    {"type": "output", "name": "log", "label": "Event Log", "height": "200px"}
  ]
}
